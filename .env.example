# Motion Studio needs NO environment variables for its basic workflow
# (validate, production, render, tests), and it does not load a .env file.
# This file only documents the optional variables the code reads. Export the
# ones you need in your shell.

# Run the two browser-based typography tests (needs npx hyperframes + Chrome).
# MS_RENDER_TESTS=1

# Where the optional numeric browser tracer is cached
# (default: a per-user cache directory outside the repository).
# MOTION_STUDIO_TRACE_CACHE=

# node_modules directory holding @hyperframes/producer and @hyperframes/core,
# read by studio/hf_trace.mjs. Set automatically by `studio/cli.py trace`.
# MS_TRACE_NODE_MODULES=

# Path to a local copy of ffmpeg-skill for the experimental
# review/ffmpeg_skill.py evidence layer.
# MOTION_STUDIO_FFMPEG_SKILL=

# Narration is optional. Motion Studio never calls a text-to-speech provider
# itself; `narration/cli.py` prints a command for you to run with your own key.
# Keep provider keys in your shell environment, never in this repository.
